{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2Read",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetSpotPlacementScores"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2ManageDcvInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:CreateImage",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:AssociateAddress"
      ],
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/dcv": "true"
        }
      }
    },
    {
      "Sid": "Ec2RunDcvInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/dcv": "true"
        }
      }
    },
    {
      "Sid": "Ec2RunInstancesResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*:${AWS::AccountId}:image/*",
        "arn:aws:ec2:*:${AWS::AccountId}:volume/*",
        "arn:aws:ec2:*:${AWS::AccountId}:network-interface/*",
        "arn:aws:ec2:*:${AWS::AccountId}:subnet/*",
        "arn:aws:ec2:*:${AWS::AccountId}:security-group/*",
        "arn:aws:ec2:*:${AWS::AccountId}:key-pair/*"
      ]
    },
    {
      "Sid": "Ec2TagOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateImage",
            "CopyImage",
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "CreateKeyPair",
            "CreateCapacityReservation"
          ]
        }
      }
    },
    {
      "Sid": "Ec2Images",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateImage",
        "ec2:CopyImage",
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:${AWS::AccountId}:image/*",
        "arn:aws:ec2:*:${AWS::AccountId}:snapshot/*"
      ]
    },
    {
      "Sid": "Ec2DeregisterDcvImages",
      "Effect": "Allow",
      "Action": "ec2:DeregisterImage",
      "Resource": "arn:aws:ec2:*::image/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/dcv-snapshot": "true"
        }
      }
    },
    {
      "Sid": "Ec2DeleteImageSnapshots",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:*::snapshot/*"
    },
    {
      "Sid": "Ec2CapacityProbe",
      "Effect": "Allow",
      "Action": "ec2:CreateCapacityReservation",
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:capacity-reservation/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/dcv:capacity-probe": "true"
        }
      }
    },
    {
      "Sid": "Ec2CapacityProbeCancel",
      "Effect": "Allow",
      "Action": "ec2:CancelCapacityReservation",
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:capacity-reservation/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/dcv:capacity-probe": "true"
        }
      }
    },
    {
      "Sid": "Ec2ElasticIp",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress"
      ],
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:elastic-ip/*"
    },
    {
      "Sid": "Ec2SetupNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateRoute",
        "ec2:AssociateRouteTable",
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateSecurityGroup",
        "ec2:CreateKeyPair"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2SetupSecurityGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/dcv:managed-by": "dcv-manager"
        }
      }
    },
    {
      "Sid": "SsmSendCommandToDcv",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:*:${AWS::AccountId}:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/dcv": "true"
        }
      }
    },
    {
      "Sid": "SsmSendCommandDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:*::document/AWS-RunPowerShellScript"
    },
    {
      "Sid": "SsmRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:CancelCommand",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SsmPasswordTransit",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:*:${AWS::AccountId}:parameter/dcv-manager/*"
    },
    {
      "Sid": "IamRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:GetInstanceProfile",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListRoles",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfiles",
        "iam:ListInstanceProfilesForRole",
        "iam:ListPolicyVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamManageDcvRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:TagRole",
        "iam:PutRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::${AWS::AccountId}:role/dcv-*",
        "arn:aws:iam::${AWS::AccountId}:instance-profile/dcv-*"
      ]
    },
    {
      "Sid": "IamAttachKnownPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::${AWS::AccountId}:role/dcv-*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore",
            "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
            "arn:aws:iam::${AWS::AccountId}:policy/dcv-manager/*"
          ]
        }
      }
    },
    {
      "Sid": "IamPassDcvRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${AWS::AccountId}:role/dcv-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "IamSharePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion"
      ],
      "Resource": "arn:aws:iam::${AWS::AccountId}:policy/dcv-manager/*"
    },
    {
      "Sid": "LambdaPowerFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:TagResource"
      ],
      "Resource": "arn:aws:lambda:*:${AWS::AccountId}:function:dcv-*"
    },
    {
      "Sid": "EventsRules",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:PutTargets",
        "events:ListTargetsByRule",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:*:${AWS::AccountId}:rule/dcv-*"
    },
    {
      "Sid": "SchedulerSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:*:${AWS::AccountId}:schedule/dcv-manager/*"
    },
    {
      "Sid": "SchedulerGroup",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetScheduleGroup",
        "scheduler:CreateScheduleGroup"
      ],
      "Resource": "arn:aws:scheduler:*:${AWS::AccountId}:schedule-group/dcv-manager"
    },
    {
      "Sid": "SchedulerList",
      "Effect": "Allow",
      "Action": "scheduler:ListSchedules",
      "Resource": "*"
    },
    {
      "Sid": "LogsStateHistory",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:*:${AWS::AccountId}:log-group:/aws/events/dcv-*"
    },
    {
      "Sid": "LogsResourcePolicy",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeResourcePolicies",
        "logs:PutResourcePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3ShareBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3Artifact",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${ArtifactBucket}/dcv-manager/*"
    },
    {
      "Sid": "ReadOnlyServices",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:LookupEvents",
        "pricing:GetProducts",
        "servicequotas:GetServiceQuota",
        "servicequotas:GetAWSDefaultServiceQuota"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CognitoUserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:AdminDisableUser",
        "cognito-idp:AdminEnableUser",
        "cognito-idp:AdminSetUserPassword",
        "cognito-idp:AdminAddUserToGroup",
        "cognito-idp:AdminRemoveUserFromGroup",
        "cognito-idp:AdminListGroupsForUser",
        "cognito-idp:ListUsers",
        "cognito-idp:ListUsersInGroup"
      ],
      "Resource": "${UserPool.Arn}"
    }
  ]
}
